# Copy to standalone/.env and fill in. Repo-root .env is also loaded first (non-overriding).

# Ollama Cloud (default host in config)
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=qwen3.5:397b
# Lighter / faster validator for run_validation.py (Ollama Cloud tag). Local: try gpt-oss:120b or gpt-oss:20b.
HW_FLIGHT_VALIDATION_MODEL=gpt-oss:120b-cloud
HW_FLIGHT_OLLAMA_TIMEOUT_SEC=1200

# Local Ollama example (uncomment and set key empty if no cloud)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_API_KEY=

# Optional: HTTP MCP bridge instead of in-process tools
# MCP_BASE_URL=http://127.0.0.1:8765

# Optional: TSA proxy (see mcp_server/tools/tsa_wait_times.py)
# TSA_WAIT_TIMES_PROXY_URL=

# RAG index location (default: hw_flight/rag/data inside standalone)
# RAG_DATA_DIR=

# Sampling temperature for chat
# OLLAMA_TEMPERATURE=0

# Verbose workflow logs (Ollama round-trips, MCP tool calls). Set 0 to quiet them.
# HW_FLIGHT_DEBUG=1

# Context limits (homework defaults shrink huge FAA/weather JSON for faster cloud turns).
# HW_FLIGHT_MAX_TOOL_RESULT_CHARS=14000   # set 0 to disable truncation (full tool JSON; often slow on cloud)
# HW_FLIGHT_OLLAMA_TIMEOUT_SEC=1200       # per-request HTTP timeout for /api/chat (default 1200 if unset)
# HW_FLIGHT_RAG_HIT_CONTENT_CHARS=2800
# HW_FLIGHT_MAX_RAG_HITS=12
